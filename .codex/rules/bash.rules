prefix_rule(
    pattern = ["blender", "--background"],
    decision = "allow",
)

prefix_rule(
    pattern = ["blender", "--factory-startup"],
    decision = "allow",
)

prefix_rule(
    pattern = ["uv", "run"],
    decision = "allow",
)

prefix_rule(
    pattern = ["godot", "--headless"],
    decision = "allow",
)

prefix_rule(
    pattern = ["godot", "--path"],
    decision = "allow"
)

prefix_rule(
    pattern = ["godot", "--xr-mode"],
    decision = "allow"
)
